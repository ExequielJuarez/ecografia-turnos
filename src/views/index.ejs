<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content">
  <meta name="theme-color" content="#0b1f3a">
  <meta name="description" content="Consultorio de ecografías: abdominal, obstétrica, ginecológica, tiroides, mamaria y doppler. Turnos online.">
  <title>EcoVida · Ecografías</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="/css/fonts.css">
  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="stylesheet" href="/css/landing.css">
</head>
<body>
  <header class="nav"><div class="wrap">
    <a class="logo" href="#top"><i></i>EcoVida</a>
    <a class="btn-e" href="#turno">Pedir turno</a>
  </div></header>

  <main id="top">
    <section class="hero">
      <div class="wrap">
        <div>
          <span class="badge-e">Diagnóstico por imágenes</span>
          <h1>Ecografías con <span>precisión</span> y trato humano.</h1>
          <p>Equipos de alta resolución, informes claros el mismo día y turnos online. Sin esperas ni llamadas.</p>
          <div class="hero-actions">
            <a class="btn-e" href="#turno">Reservar turno</a>
            <a class="btn-e alt" href="#estudios">Ver estudios</a>
          </div>
        </div>
        <div class="scope" aria-hidden="true"></div>
      </div>
      <div class="wave-wrap" aria-hidden="true">
        <svg class="wave" viewBox="0 0 1200 90" preserveAspectRatio="none"><path d="M0 45 H80 L100 45 L115 12 L135 78 L150 45 H300 L318 45 L333 22 L350 68 L365 45 H520 L538 45 L553 8 L572 82 L588 45 H600 H680 L700 45 L715 12 L735 78 L750 45 H900 L918 45 L933 22 L950 68 L965 45 H1120 L1138 45 L1153 8 L1172 82 L1188 45 H1200" fill="none" stroke="currentColor" stroke-width="2" vector-effect="non-scaling-stroke"/></svg>
      </div>
    </section>

    <div class="trust"><div class="wrap">
      <div><b>Mismo día</b><span>Informe entregado</span></div>
      <div><b>4D</b><span>Equipos de última generación</span></div>
      <div><b>+12.000</b><span>Estudios realizados</span></div>
      <div><b>Obras sociales</b><span>Consultá cobertura</span></div>
    </div></div>

    <section id="estudios"><div class="wrap">
      <h2 class="sec-h reveal">Estudios <span style="color:var(--accent)">disponibles</span></h2>
      <p class="sec-p reveal">Cada estudio indica la preparación previa. Con orden médica o de forma particular.</p>
      <%- include('partials/servicios', { servicios }) %>
      <div class="steps reveal">
        <div><b>Elegí tu turno</b><span>Seleccioná estudio, día y horario.</span></div>
        <div><b>Confirmación</b><span>Te escribimos por WhatsApp.</span></div>
        <div><b>Venís al consultorio</b><span>Con la preparación indicada y tu orden.</span></div>
      </div>
    </div></section>

    <section id="turno" class="book"><div class="wrap">
      <div class="reveal">
        <h2 class="sec-h">Reservá tu <span style="color:#52c7ff">estudio</span></h2>
        <p class="sec-p">Tres pasos y listo. Podés cambiar o cancelar escribiéndonos por WhatsApp.</p>
        <div class="info"><span data-cfg="address"></span><span data-cfg="hoursText"></span></div>
      </div>
      <div class="book-card reveal"><div id="booking"></div></div>
    </div></section>
  </main>

  <footer><div class="wrap">© EcoVida Diagnóstico · Informes de carácter médico supervisados por profesional matriculado</div></footer>

  <a class="wa-float" data-wa="Hola! Quiero consultar por una ecografía" aria-label="Escribinos por WhatsApp">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12.04 2a9.9 9.9 0 0 0-8.4 15.1L2 22l5-1.6A9.9 9.9 0 1 0 12.04 2Zm5.8 14c-.25.7-1.4 1.3-1.95 1.35-.5.05-1.1.2-3.7-.8-3.1-1.2-5.1-4.4-5.25-4.6-.15-.2-1.25-1.65-1.25-3.15s.8-2.25 1.1-2.55c.3-.3.6-.35.8-.35h.55c.18 0 .42-.07.65.5.25.6.85 2.1.92 2.25.08.15.12.33.02.52-.1.2-.15.32-.3.5-.15.17-.3.38-.45.5-.15.15-.3.3-.13.6.18.3.78 1.28 1.68 2.07 1.15 1.02 2.12 1.35 2.42 1.5.3.15.48.12.65-.07.18-.2.75-.87.95-1.17.2-.3.4-.25.68-.15.27.1 1.75.83 2.05.98.3.15.5.22.57.35.08.12.08.72-.17 1.4Z"/></svg>
  </a>
  <script type="module" src="/js/landing.js"></script>
</body>
</html>
